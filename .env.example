# Copy to .env.local to run standalone (outside Docker). Never commit the
# result. On Railway, this same variable is set in the service's dashboard
# (Settings -> Variables), not in a file.

# URL the browser uses to reach the backend. Has to be a URL the visitor's
# machine can actually resolve — not an internal Docker network name.
NEXT_PUBLIC_API_URL=http://localhost:4000

FRONTEND_PORT=3000
